# Copy this file to .env and fill in real values. .env is ignored by git and must never be committed.
# On Vercel, add the same variables under Project > Settings > Environment Variables, then redeploy.

# Supabase (public by design, protected by database rules). Find them in Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The studio owner's login email
VITE_OWNER_EMAIL=you@example.com

# Local development only: your n8n webhook, used by the dev server to forward the contact form.
VITE_N8N_WEBHOOK_URL=https://your-n8n-host/webhook/portfolio-request

# NEVER put these in a VITE_ variable or in the code: Supabase service_role key, n8n API key,
# Gmail credentials, any password. Keep them in n8n/Supabase/Vercel secret storage only.

# n8n access for Claude Code only (not used by the website, never prefix with VITE_).
# N8N_API_URL=https://your-n8n-host
# N8N_API_KEY=create one in n8n > Settings > n8n API
