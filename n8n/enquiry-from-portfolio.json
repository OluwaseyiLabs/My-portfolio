      "parameters": {
        "sendTo": "oluwaseyidavid406@gmail.com",
        "subject": "={{ 'New enquiry from ' + $json.name + ($json.company ? ' (' + $json.company + ')' : ' (Portfolio)') }}",
        "message": "={{ (() => {\n  const d = $json;\n\n  const esc = (v) => String(v ?? '').replace(/[&<>\"']/g, c => ({\n    '&': '&amp;',\n    '<': '&lt;',\n    '>': '&gt;',\n    '\"': '&quot;',\n    \"'\": '&#39;'\n  }[c]));\n\n  const name = esc(d.name);\n  const email = esc(d.email);\n  const timestamp = esc(d.timestamp);\n  const source = esc('portfolio_contact_form');\n  const message = esc(d.message).replace(/\\r\\n|\\r|\\n/g, '<br>');\n  const year = new Date().getFullYear();\n  const row = (label, valueHtml, last) => `<tr>\n<td style=\"padding:17px 20px;${last ? '' : 'border-bottom:1px solid #E0E0E0;'}\">\n<div style=\"font-size:11px;line-height:1.5;letter-spacing:1.5px;color:#777777;margin-bottom:8px;font-weight:bold;\">${label}</div>\n<div style=\"font-size:15px;line-height:1.6;color:#141414;word-break:break-word;\">${valueHtml}</div>\n</td>\n</tr>`;\n  const link = (href, text) => `<a href=\"${href}\" style=\"color:#141414;text-decoration:underline;word-break:break-word;\">${text}</a>`;\n  const nl = (v) => esc(v).replace(/\\r\\n|\\r|\\n/g, '<br>');\n  const site = /^https?:\\/\\//i.test(String(d.website || '')) ? link(esc(d.website), esc(d.website)) : '';\n  const extraBlock = d.extra_info ? `\n<tr>\n<td bgcolor=\"#FFFFFF\" style=\"padding:0 30px 30px;background-color:#FFFFFF;\">\n<div style=\"font-size:11px;line-height:1.5;letter-spacing:2px;color:#777777;font-weight:bold;margin-bottom:14px;\">\nANYTHING ELSE THEY SHARED\n</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#F5F5F5\" style=\"width:100%;background-color:#F5F5F5;border:1px solid #E5E5E5;\">\n<tr>\n<td style=\"padding:22px;font-size:15px;line-height:1.9;color:#333333;word-break:break-word;\">\n${nl(d.extra_info)}\n</td>\n</tr>\n</table>\n</td>\n</tr>` : '';\n  const entries = [\n    ['CLIENT NAME', '<strong>' + name + '</strong>'],\n    ['EMAIL ADDRESS', link('mailto:' + email, email)],\n    d.company && ['COMPANY', esc(d.company)],\n    site && ['COMPANY WEBSITE', site],\n    d.role && ['THEIR ROLE', esc(d.role)],\n    d.company_size && ['COMPANY SIZE', esc(d.company_size)],\n    d.annual_revenue && ['ANNUAL REVENUE', esc(d.annual_revenue)],\n    d.project_budget && ['PROJECT BUDGET', esc(d.project_budget)],\n    d.interests && ['HOPING TO IMPROVE', esc(d.interests)],\n    ['DATE & TIME RECEIVED', timestamp + ' (Lagos time)'],\n    ['SUBMISSION SOURCE', source],\n  ].filter(Boolean);\n  const detailRows = entries.map((e, i) => row(e[0], e[1], i === entries.length - 1)).join('');\n\n  return `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>New Website Enquiry | Oluwaseyi.</title>\n</head>\n\n<body style=\"margin:0;padding:0;background-color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;color:#141414;\">\n\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#FFFFFF\" style=\"width:100%;background-color:#FFFFFF;\">\n<tr>\n<td align=\"center\" style=\"padding:30px 15px;background-color:#FFFFFF;\">\n\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#FFFFFF\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border:1px solid #E5E5E5;\">\n\n<!-- BLACK HEADER -->\n<tr>\n<td align=\"center\" bgcolor=\"#141414\" style=\"padding:38px 25px;text-align:center;background-color:#141414;border-bottom:1px solid #333333;\">\n\n<div style=\"font-size:28px;line-height:1.3;font-weight:700;letter-spacing:-1px;color:#FFFFFF;\">\nOluwaseyi.\n</div>\n\n<div style=\"font-size:10px;line-height:1.8;letter-spacing:2px;text-transform:uppercase;color:#A3A3A3;margin-top:10px;\">\nBuilding systems that work for your business.\n</div>\n\n</td>\n</tr>\n\n<!-- WHITE INTRODUCTION -->\n<tr>\n<td bgcolor=\"#FFFFFF\" style=\"padding:38px 30px 25px;background-color:#FFFFFF;\">\n\n<div style=\"font-size:11px;line-height:1.5;letter-spacing:2px;color:#777777;font-weight:bold;\">\nNEW WEBSITE ENQUIRY\n</div>\n\n<h1 style=\"font-size:28px;line-height:1.3;letter-spacing:-1px;color:#141414;margin:17px 0 12px;font-weight:700;\">\nYou've received a new message.\n</h1>\n\n<p style=\"font-size:15px;line-height:1.9;color:#555555;margin:0;\">\nSomeone has submitted an enquiry through your portfolio website. Here are the details.\n</p>\n\n</td>\n</tr>\n\n<!-- CLIENT DETAILS -->\n<tr>\n<td bgcolor=\"#FFFFFF\" style=\"padding:0 30px 30px;background-color:#FFFFFF;\">\n\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#F5F5F5\" style=\"width:100%;background-color:#F5F5F5;border:1px solid #E5E5E5;\">\n${detailRows}\n</table>\n</td>\n</tr>\n\n<!-- CLIENT MESSAGE -->\n<tr>\n<td bgcolor=\"#FFFFFF\" style=\"padding:0 30px 30px;background-color:#FFFFFF;\">\n\n<div style=\"font-size:11px;line-height:1.5;letter-spacing:2px;color:#777777;font-weight:bold;margin-bottom:14px;\">\nHOW CAN I HELP?\n</div>\n\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#F5F5F5\" style=\"width:100%;background-color:#F5F5F5;border:1px solid #E5E5E5;\">\n<tr>\n<td style=\"padding:22px;font-size:15px;line-height:1.9;color:#333333;word-break:break-word;\">\n${message}\n</td>\n</tr>\n</table>\n\n</td>\n</tr>\n\n${extraBlock}\n<!-- REPLY BUTTON -->\n<tr>\n<td bgcolor=\"#FFFFFF\" style=\"padding:0 30px 35px;background-color:#FFFFFF;\">\n\n<a href=\"mailto:${email}\" style=\"display:inline-block;background-color:#141414;color:#FFFFFF;text-decoration:none;font-size:15px;font-weight:bold;padding:16px 25px;\">\nReply to client &nbsp; &rarr;\n</a>\n\n</td>\n</tr>\n\n<!-- SIGNATURE: WHITE -->\n<tr>\n<td align=\"center\" bgcolor=\"#FFFFFF\" style=\"padding:27px 25px;background-color:#FFFFFF;border-top:1px solid #E5E5E5;text-align:center;\">\n\n<p style=\"font-size:18px;line-height:1.5;font-weight:700;color:#141414;margin:0 0 7px;\">\nOluwaseyi.\n</p>\n\n<p style=\"font-size:13px;line-height:1.6;letter-spacing:0.3px;color:#777777;margin:0;\">\nAI Automation Specialist &amp; Web Dev\n</p>\n\n</td>\n</tr>\n\n<!-- BLACK COPYRIGHT FOOTER -->\n<tr>\n<td align=\"center\" bgcolor=\"#141414\" style=\"padding:24px 20px;background-color:#141414;text-align:center;\">\n\n<p style=\"font-size:11px;line-height:1.8;color:#FFFFFF;margin:0;\">\nThis notification was automatically generated by your portfolio contact form.\n</p>\n\n<p style=\"font-size:11px;line-height:1.8;color:#A3A3A3;margin:8px 0 0;\">\n&copy; ${year} Oluwaseyi. All rights reserved.\n</p>\n\n</td>\n</tr>\n\n</table>\n</td>\n</tr>\n</table>\n\n</body>\n</html>`;\n})() }}",
        "options": {
